{
  "name": "auren-backend",
  "version": "1.0.0",
  "description": "API de agendamento de exames e laudos (desafio técnico Auren)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:render": "prisma migrate deploy && tsx prisma/ensure-seeded.ts && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/jwt": "^10.2.7",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "luxon": "^3.7.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true
  }
}
