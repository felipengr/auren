DATABASE_URL="file:./dev.db"

# Generate your own secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

PORT=3333
NODE_ENV=development

# Origin allowed to call the API with credentials (the frontend URL)
CORS_ORIGIN="http://localhost:5173"
